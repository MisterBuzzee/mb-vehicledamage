{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mb-vehicledamage/data/settings.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    },
    "globalSeverity": {
      "description": "Global severity",
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "minorDeltaV": {
      "description": "Minor delta-V",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "moderateDeltaV": {
      "description": "Moderate delta-V",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "severeDeltaV": {
      "description": "Severe delta-V",
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "smokeAtEngineHP": {
      "description": "Smoke at HP",
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "fireAtEngineHP": {
      "description": "Fire at HP",
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "tireItem": {
      "description": "Tire item name",
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "tireRepairAll": {
      "description": "Repair all tires",
      "type": "boolean"
    }
  },
  "required": [
    "minorDeltaV",
    "moderateDeltaV",
    "severeDeltaV",
    "smokeAtEngineHP",
    "fireAtEngineHP",
    "tireItem",
    "tireRepairAll"
  ]
}
